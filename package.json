{
  "name": "netfly",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "dev": "pnpm --parallel --filter @netfly/client --filter @netfly/admin dev",
    "build": "pnpm --filter @netfly/client --filter @netfly/admin build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "api:generate": "pnpm --filter @netfly/api-client generate",
    "e2e": "pnpm --filter @netfly/e2e test"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "@tailwindcss/oxide", "unrs-resolver"]
  }
}
