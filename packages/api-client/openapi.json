{
    "openapi": "3.0.3",
    "info": {
        "title": "NETFLY API",
        "version": "1.0.0",
        "description": "Streaming platform API (viewer + staff)."
    },
    "paths": {
        "/api/health": {
            "get": {
                "operationId": "health",
                "tags": [
                    "api"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/public/config": {
            "get": {
                "operationId": "public_config",
                "description": "Branding, feature flags and player defaults (`is_public` entries only).",
                "tags": [
                    "config"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicConfig"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "operationId": "auth_login",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "operationId": "auth_logout",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AppRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/AppRequest"
                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "operationId": "auth_me",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "patch": {
                "operationId": "auth_me_update",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUserRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUserRequest"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/me/password": {
            "post": {
                "operationId": "auth_change_password",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChangePasswordRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ChangePasswordRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "operationId": "auth_refresh",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AppRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/AppRequest"
                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/signup": {
            "post": {
                "operationId": "auth_signup",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignupRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/SignupRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/username-available": {
            "get": {
                "operationId": "auth_username_available",
                "parameters": [
                    {
                        "in": "query",
                        "name": "username",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "auth"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsernameAvailability"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/legal/{slug}": {
            "get": {
                "operationId": "legal_page",
                "parameters": [
                    {
                        "in": "path",
                        "name": "slug",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "legal"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LegalPage"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AppEnum": {
                "enum": [
                    "client",
                    "admin"
                ],
                "type": "string",
                "description": "* `client` - client\n* `admin` - admin"
            },
            "AppRequest": {
                "type": "object",
                "properties": {
                    "app": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/AppEnum"
                            }
                        ],
                        "default": "client"
                    }
                }
            },
            "BlankEnum": {
                "enum": [
                    ""
                ]
            },
            "ChangePasswordRequest": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string",
                        "minLength": 1
                    },
                    "new_password": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "current_password",
                    "new_password"
                ]
            },
            "Health": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "ok"
                ]
            },
            "LegalPage": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string",
                        "maxLength": 50,
                        "pattern": "^[-a-zA-Z0-9_]+$"
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "body_markdown": {
                        "type": "string"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "slug",
                    "title",
                    "updated_at"
                ]
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "app": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/AppEnum"
                            }
                        ],
                        "default": "client"
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            },
            "PatchedUserRequest": {
                "type": "object",
                "properties": {
                    "full_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                    },
                    "translation_mode": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/TranslationModeEnum"
                            },
                            {
                                "$ref": "#/components/schemas/BlankEnum"
                            }
                        ]
                    },
                    "preferred_quality": {
                        "type": "string",
                        "maxLength": 12
                    },
                    "autoplay_next": {
                        "type": "boolean"
                    },
                    "autoplay_previews": {
                        "type": "boolean"
                    },
                    "subtitles_language": {
                        "type": "string",
                        "maxLength": 12
                    }
                }
            },
            "PublicConfig": {
                "type": "object",
                "properties": {
                    "values": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "values"
                ]
            },
            "RoleEnum": {
                "enum": [
                    "superadmin",
                    "content_manager",
                    "analyst"
                ],
                "type": "string",
                "description": "* `superadmin` - Super admin\n* `content_manager` - Content manager\n* `analyst` - Analyst"
            },
            "Session": {
                "type": "object",
                "properties": {
                    "access": {
                        "type": "string"
                    },
                    "expires_in": {
                        "type": "integer"
                    },
                    "csrf": {
                        "type": "string"
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "required": [
                    "access",
                    "csrf",
                    "expires_in",
                    "user"
                ]
            },
            "SignupRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30
                    },
                    "full_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "app": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/AppEnum"
                            }
                        ],
                        "default": "client"
                    }
                },
                "required": [
                    "full_name",
                    "password",
                    "username"
                ]
            },
            "TranslationModeEnum": {
                "enum": [
                    "translated",
                    "not_translated",
                    "all"
                ],
                "type": "string",
                "description": "* `translated` - Translated\n* `not_translated` - Not Translated\n* `all` - All"
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "username": {
                        "type": "string",
                        "readOnly": true
                    },
                    "full_name": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "is_staff": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "role": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/RoleEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "translation_mode": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/TranslationModeEnum"
                            },
                            {
                                "$ref": "#/components/schemas/BlankEnum"
                            }
                        ]
                    },
                    "preferred_quality": {
                        "type": "string",
                        "maxLength": 12
                    },
                    "autoplay_next": {
                        "type": "boolean"
                    },
                    "autoplay_previews": {
                        "type": "boolean"
                    },
                    "subtitles_language": {
                        "type": "string",
                        "maxLength": 12
                    }
                },
                "required": [
                    "created_at",
                    "full_name",
                    "id",
                    "is_staff",
                    "role",
                    "username"
                ]
            },
            "UsernameAvailability": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "available": {
                        "type": "boolean"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "available",
                    "message",
                    "username"
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
